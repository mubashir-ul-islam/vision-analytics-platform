# Smart Attendance — CompreFace Connection
# Internal Docker service URL — do not change
COMPREFACE_URL=http://compreface-fe:80

# Obtain from CompreFace UI (http://localhost:8000) after first run:
# 1. Create an account
# 2. Create a "Recognition" service
# 3. Copy the API key and paste it here
COMPREFACE_API_KEY=REPLACE_ME_AFTER_COMPREFACE_SETUP

# Smart Attendance — Camera Sources
# Set to a device index (0, 2, 4) or a full RTSP URL
# Example RTSP: rtsp://user:password@192.168.1.100:554/stream
ENTRANCE_CAMERA_SOURCE=0
EXIT_CAMERA_SOURCE=2

# Smart Attendance — Tuning
RECOGNITION_THRESHOLD=0.85
RECOGNITION_INTERVAL_SECONDS=2
COOLDOWN_MINUTES=0.083
DATABASE_URL=sqlite:////data/attendance.db
BACKEND_PORT=8080
BACKEND_CORS_ORIGINS=http://localhost:3000

# ── Demo Expiry ────────────────────────────────────────────────────────────
# Set to YYYY-MM-DD to lock all services after this date.
# Leave blank to disable expiry (for non-demo / permanent deployments).
# After expiry: containers refuse to start. Combined with setup-expiry.sh,
# Docker images, volumes, and source files are also deleted from disk.
DEMO_EXPIRES_DATE=

# ── Phone Detection ────────────────────────────────────────────────────────
# Camera source for phone-detection is in phone-detection/state.json
# If it contains an RTSP URL with credentials, update it to your own camera
# before running. The "camera_source" field accepts a device index (0) or
# a full RTSP URL.
